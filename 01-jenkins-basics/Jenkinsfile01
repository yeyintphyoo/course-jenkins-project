pipeline {
    agent {
        docker {
            image 'python:3.12-slim'
            reuseNode true
        }
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python --version
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh 'pytest -v'
            }
        }
    }
}